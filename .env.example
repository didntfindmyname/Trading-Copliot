APP_NAME=Athena AI Engineering Copilot
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://athena:athena@postgres:5432/athena
SYNC_DATABASE_URL=postgresql+psycopg://athena:athena@postgres:5432/athena
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=athena_chunks

LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
